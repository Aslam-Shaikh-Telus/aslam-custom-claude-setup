    "kit/hooks/security-sinks.js",
    "kit/hooks/guard-datadog-writes.js",
    "kit/hooks/test-guard-datadog-writes.js",
    "kit/agents/Explore.md",
    "kit/agents/locator.md",
    "kit/agents/opus-consult.md",
    "kit/agents/opus-step.md",
    "kit/agents/scoped-reviewer.md",
    "kit/skills/plan-progress-tracker/",
    "kit/skills/troubleshooting/",
    "kit/skills/code-craft/",
    "kit/skills/documentation/",
    "kit/skills/system-design/",
    "kit/skills/tui-design/",
